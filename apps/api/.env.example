# Local development against `pnpm db:up` (compose.yaml).
DATABASE_URL=postgres://homelibra_app:app@localhost:5432/homelibra
MIGRATION_DATABASE_URL=postgres://homelibra_owner:owner@localhost:5432/homelibra
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# RESEND_API_KEY=
# Google sign-in. Without these, "Google ile devam et" fails and only email codes work.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
TRUSTED_ORIGINS=homelibra://
CORS_ORIGINS=http://localhost:8081
# Error and performance monitoring; leave unset to keep Sentry off.
