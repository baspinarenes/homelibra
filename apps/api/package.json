{
  "name": "@homelibra/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/server.ts",
    "start": "tsx --import ./src/instrument.ts src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.14",
    "@homelibra/core": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@sentry/node": "^11.10.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "resend": "^6.35.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  }
}
