{
  "expo": {
    "name": "Homelibra",
    "slug": "homelibra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homelibra",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.homelibra",
      "adaptiveIcon": {
        "backgroundColor": "#A65A40",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "app.homelibra"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      ["@sentry/react-native/expo", { "organization": "enes-baspnar", "project": "homelibra-app" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
