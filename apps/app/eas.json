{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.11.0",
      "pnpm": "11.8.0",
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.11.0",
      "pnpm": "11.8.0",
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "production": {
      "channel": "production",
      "node": "24.11.0",
      "pnpm": "11.8.0",
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      }
    }
  }
}
