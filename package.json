{
  "name": "homelibra",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "scripts/go.sh run .",
    "dev:android": "scripts/go.sh run . --platform android",
    "dev:ios": "scripts/go.sh run . --platform ios",
    "dev:web": "scripts/go.sh run . --platform web",
    "dev:api": "scripts/go.sh run . --platform api",
    "check": "pnpm gen:theme --check && pnpm typecheck && pnpm lint:boundaries && pnpm lint && pnpm test:unit && pnpm test:scripts && pnpm test:dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "lint:boundaries": "depcruise apps packages",
    "test": "pnpm -r test && pnpm test:scripts && pnpm test:dev",
    "test:unit": "pnpm -r --filter=!@homelibra/api test",
    "test:api": "pnpm --filter @homelibra/api test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:dev": "scripts/go.sh vet ./... && scripts/go.sh test ./... && scripts/go.sh build -o /dev/null .",
    "db:up": "docker compose up -d --build postgres",
    "db:migrate": "pnpm --filter @homelibra/api db:migrate",
    "db:generate": "pnpm --filter @homelibra/api db:generate",
    "invite": "pnpm --filter @homelibra/api invite",
    "usage": "pnpm --filter @homelibra/api usage",
    "version:bump": "node scripts/version-bump.mjs bump",
    "prepare": "husky",
    "gen:theme": "node scripts/gen-theme.mjs",
    "gen": "node scripts/gen.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
