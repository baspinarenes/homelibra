{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "refactor-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3001",
        "BETTER_AUTH_URL=http://localhost:3001",
        "CORS_ORIGINS=http://localhost:8091",
        "SENTRY_DSN=",
        "pnpm",
        "--filter",
        "@homelibra/api",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "refactor-native",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:3001",
        "pnpm",
        "--filter",
        "@homelibra/app",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8092"
      ],
      "port": 8092
    },
    {
      "name": "refactor-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:3001",
        "pnpm",
        "--filter",
        "@homelibra/app",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8091"
      ],
      "port": 8091
    }
  ]
}
